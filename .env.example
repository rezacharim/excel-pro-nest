# Excel Pro Soccer Academy backend - environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (Supabase Postgres) ---
DB_TYPE=postgres                          # TypeORM driver type
DB_HOST=db.xxxxxxxxxxxx.supabase.co       # Postgres host
DB_PORT=5432                              # Postgres port
DB_USERNAME=postgres                      # Postgres user
DB_PASSWORD=your-db-password              # Postgres password
DB_DATABASE=postgres                      # Database name
DB_SSL=true # set to false only for a local non-SSL Postgres

# --- App ---
NODE_ENV=development                      # development | production
PORT=4000                                 # HTTP port the Nest app listens on
JWT_SECRET=change-me-to-a-long-random-string  # Secret for signing admin JWTs

# --- Redis (Upstash, used for OTP storage) ---
REDIS_URI=rediss://default:password@host:6379  # Upstash Redis connection URI

# --- Stripe (secondary/online payment path) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx    # Stripe secret API key
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx  # Stripe webhook signing secret

# --- Stripe price IDs per age-group plan ---
U5_U8=price_xxxxxxxxxxxx                  # Stripe price ID for U5-U8 plan
U9_U12=price_xxxxxxxxxxxx                 # Stripe price ID for U9-U12 plan
U13_U14=price_xxxxxxxxxxxx                # Stripe price ID for U13-U14 plan
U15_U18=price_xxxxxxxxxxxx                # Stripe price ID for U15-U18 plan

# --- Twilio (SMS: OTP, payment and renewal notifications) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx     # Twilio account SID
TWILIO_AUTH_TOKEN=your-twilio-auth-token  # Twilio auth token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx          # Twilio sender phone number
ADMIN_PHONE_NUMBERS=+1xxxxxxxxxx,+1yyyyyyyyyy  # Comma-separated admin phones for SMS alerts

# --- Supabase (file storage for user photos) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co  # Supabase project URL
SUPABASE_KEY=your-supabase-service-key    # Supabase service role/API key

# --- SMTP email (new - renewal reminders, receipts, welcome, admin digest) ---
SMTP_HOST=smtp.gmail.com                  # SMTP server host; leave unset to disable email (no-op)
SMTP_PORT=587                             # SMTP port (default 587)
SMTP_SECURE=false                         # true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_USER=excelprosocceracademy@gmail.com # SMTP username
SMTP_PASS=your-gmail-app-password         # SMTP password (Gmail: use an App Password)
MAIL_FROM="Excel Pro Soccer Academy <excelprosocceracademy@gmail.com>"  # From header for outgoing mail
ADMIN_EMAILS=admin1@example.com,admin2@example.com  # Comma-separated recipients of the daily admin digest
